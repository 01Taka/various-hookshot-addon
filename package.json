{
  "name": "various-hookshot-addon",
  "version": "1.0.0",
  "type": "module",
  "description": "Various Hookshot Addon for Minecraft Bedrock",
  "minecraftAddon": {
    "namespace": "various_hookshot_addon"
  },
  "scripts": {
    "build": "minecraft-cli build",
    "build:bp": "minecraft-cli build -b",
    "build:rp": "minecraft-cli build -r",
